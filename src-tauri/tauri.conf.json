{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AID-C2S V5 — Simulation Trainer",
  "version": "5.0.0",
  "identifier": "com.aidc2s.simulation.trainer",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "AID-C2S V5 Simulation Trainer",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": [
      "msi",
      "nsis"
    ]
  }
}
