{
  "name": "aid-c2s-v5",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run validate:source && npm run test:offline && npm run test:backend && npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "test:offline": "node scripts/v5-offline-validation.mjs",
    "validate:source": "node scripts/v5-source-validate.mjs",
    "api": "node server/index.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "test:backend": "node tests/backend-api.test.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@tauri-apps/api": "2.12.0",
    "dexie": "4.4.6",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "description": "AID-C2S V5: local-first deterministic synthetic simulation and training platform for SIH problem statement 26247."
}
